rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperUser() {
      return request.auth != null && 
        request.auth.token.email == 'julio.gamedesign@gmail.com';
    }

    function isRoomCreator(roomData) {
      return request.auth != null && (
        roomData.createdBy == request.auth.uid ||
        (roomData.creatorEmail != null && roomData.creatorEmail == request.auth.token.email)
      );
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.code is string 
                    && request.resource.data.code.size() >= 3 
                    && request.resource.data.code.size() <= 32;
      allow update: if true;
      allow delete: if roomId != 'ZH-GERAL' && (
        isSuperUser() || 
        isRoomCreator(resource.data)
      );

      // Messages in room
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.phrase is map
                      && request.resource.data.phrase.hanzi is string
                      && request.resource.data.senderName is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
        allow delete: if isSuperUser() || (
          request.auth != null && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
            get(/databases/$(database)/documents/rooms/$(roomId)).data.creatorEmail == request.auth.token.email
          )
        );
      }
    }
  }
}

