rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.code is string 
                    && request.resource.data.code.size() >= 3 
                    && request.resource.data.code.size() <= 32;
      allow update: if true;
      allow delete: if false;

      // Messages in room
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.phrase is map
                      && request.resource.data.phrase.hanzi is string
                      && request.resource.data.senderName is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
        allow delete: if false;
      }
    }
  }
}
